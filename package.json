{
  "name": "expo-styles",
  "version": "1.0.0",
  "description": "Ready-made, type-safe style utilities (layout, spacing, typography, 490+ colors, shadows) and every Reanimated animation preset for Expo and React Native. Short aliases (s, v, t, i, c, a) and camelCase + snake_case keys.",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/module/index.js"
    },
    "./view": {
      "types": "./lib/typescript/view.d.ts",
      "react-native": "./src/view.ts",
      "import": "./lib/module/view.js",
      "require": "./lib/commonjs/view.js",
      "default": "./lib/module/view.js"
    },
    "./text": {
      "types": "./lib/typescript/text.d.ts",
      "react-native": "./src/text.ts",
      "import": "./lib/module/text.js",
      "require": "./lib/commonjs/text.js",
      "default": "./lib/module/text.js"
    },
    "./img": {
      "types": "./lib/typescript/img.d.ts",
      "react-native": "./src/img.ts",
      "import": "./lib/module/img.js",
      "require": "./lib/commonjs/img.js",
      "default": "./lib/module/img.js"
    },
    "./colors": {
      "types": "./lib/typescript/colors.d.ts",
      "react-native": "./src/colors.ts",
      "import": "./lib/module/colors.js",
      "require": "./lib/commonjs/colors.js",
      "default": "./lib/module/colors.js"
    },
    "./anim": {
      "types": "./lib/typescript/anim.d.ts",
      "react-native": "./src/anim.ts",
      "import": "./lib/module/anim.js",
      "require": "./lib/commonjs/anim.js",
      "default": "./lib/module/anim.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf lib",
    "build:commonjs": "tsc -p tsconfig.build.json --module commonjs --moduleResolution node10 --noCheck --outDir lib/commonjs",
    "build:module": "tsc -p tsconfig.build.json --module esnext --moduleResolution bundler --outDir lib/module",
    "build:types": "tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "build": "npm run clean && npm run build:commonjs && npm run build:module && npm run build:types",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "keywords": [
    "react-native",
    "expo",
    "styles",
    "stylesheet",
    "utility-styles",
    "design-tokens",
    "theme",
    "colors",
    "typography",
    "spacing",
    "flexbox",
    "shadows",
    "reanimated",
    "animations",
    "ios",
    "android",
    "web",
    "typescript",
    "tailwind-colors",
    "css-colors",
    "snake-case",
    "layout-animations",
    "utility-first"
  ],
  "author": "Yindeish <adeshinaadam03@gmail.com> (https://github.com/Yindeish)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yindeish/expo-styles.git"
  },
  "bugs": {
    "url": "https://github.com/Yindeish/expo-styles/issues"
  },
  "homepage": "https://github.com/Yindeish/expo-styles#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.1",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "^0.13.1",
    "typescript": "^5.9.3"
  }
}
